# Copy to .env and fill in. Never commit .env. Values here are placeholders only.

# --- Brain (Claude Agent SDK) ---
# An Anthropic API key (https://platform.claude.com/settings/keys). The Claude brain also needs
# Claude Code installed (https://code.claude.com/docs/en/setup); Spark runs it with this key.
ANTHROPIC_API_KEY=

# --- Wake word (Porcupine, default backend) ---
# Get one at https://console.picovoice.ai
PICOVOICE_ACCESS_KEY=

# --- Optional cloud STT / TTS backends ---
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# --- Connectors (Phase 2, referenced from mcp_servers.json via ${VAR}; see docs/connectors.md §5) ---
# A server whose variables are missing or empty is disabled with a warning; Spark still starts.
# GitHub (the github sample in mcp_servers.json): a fine-grained token with Issues: Read and
# write, Pull requests: Read and Contents: Read. Or paste it in the Connectors window instead.
# Deliberately not GITHUB_TOKEN: gh would prefer it over its own login.
SPARK_GITHUB_PAT=

# --- Optional config overrides (prefix SPARK_, nested keys joined with __) ---
# SPARK_STT__BACKEND=faster_whisper
# SPARK_TTS__BACKEND=piper
# SPARK_BRAIN__BACKEND=claude_agent
# SPARK_MODELS_DIR=./.models
